# Copy to .env.  NEVER commit .env or ./secrets.
# Development (compose.yaml) reads everything from here.
# Production (compose.prod.yaml) reads only the non-secret values; secrets come from ./secrets/* (scripts/init-secrets.*).

# ---- public address -------------------------------------------------------------------------
SERVER_NAME=localhost
PUBLIC_URL=http://localhost:8080
# Must match, character for character, the Redirect URI registered in TikTok for Developers (HTTPS in production)
TIKTOK_REDIRECT_URI=http://localhost:8080/oauth/tiktok/callback

# ---- TikTok (https://developers.tiktok.com -> your app -> Login Kit + Content Posting API) --
TIKTOK_CLIENT_KEY=
# development only; in production the client secret is the file ./secrets/tiktok_client_secret
TIKTOK_CLIENT_SECRET=
# direct post needs video.publish; "upload to inbox" additionally needs video.upload
TIKTOK_SCOPES=user.info.basic,video.publish
# Set to true ONLY after TikTok has audited your app; until then posts are limited to SELF_ONLY
TIKTOK_CLIENT_AUDITED=false

# ---- first administrator (created at start-up if missing) -----------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# development only; in production: ./secrets/bootstrap_admin_password
BOOTSTRAP_ADMIN_PASSWORD=

# ---- limits ---------------------------------------------------------------------------------
MAX_VIDEO_MB=512
WORKER_CONCURRENCY=2

# ---- development secrets (compose.yaml). Replace with real random values; production uses ./secrets --------
POSTGRES_PASSWORD=dev-postgres-password-change-me
REDIS_PASSWORD=dev-redis-password-change-me
# >= 32 random characters
SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
# Fernet key(s), comma separated, first one encrypts:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=

# ---- production only ------------------------------------------------------------------------
LETSENCRYPT_EMAIL=
