# DEVELOPMENT: plain HTTP on :8080, Vite HMR for the frontend, optional mock TikTok.

resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 127.0.0.1:8081;
    access_log off;
    location = /nginx-health { return 200 "ok\n"; }
}

server {
    listen 8080;
    server_name _;
    client_max_body_size ${MAX_UPLOAD_MB}m;

    set $backend_api http://backend:8000;
    set $frontend_dev http://frontend:5173;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # WebSocket upgrade for Vite HMR. NB: proxy_set_header in a location would replace ALL inherited ones.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 600s;

    location /api/    { proxy_request_buffering off; proxy_pass $backend_api; }
    location /oauth/  { proxy_pass $backend_api; }
    location /health  { proxy_pass $backend_api; }

    # `docker compose --profile mock up` - local stand-in for TikTok's consent page
    location /mock-tiktok/ {
        set $mock http://mock-tiktok:9000;
        rewrite ^/mock-tiktok/(.*)$ /$1 break;
        proxy_pass $mock;
    }

    location / {
        proxy_pass $frontend_dev;
    }
}
